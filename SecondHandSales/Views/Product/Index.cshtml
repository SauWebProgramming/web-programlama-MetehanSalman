@model IEnumerable<SecondHandSales.Models.Product>

@{
    ViewData["Title"] = "İkinci El Ürünler";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>İkinci El Ürün İlanları</h2>
        @if (User.Identity.IsAuthenticated)
        {
            <a asp-controller="Product" asp-action="Create" class="btn btn-success">Yeni İlan Ekle</a>
        }
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="~/images/@item.ImageUrl" class="card-img-top" alt="@item.Title" style="height: 200px; object-fit: cover;">
                    }
                    else
                    {
                        <img src="https://via.placeholder.com/300x200?text=Resim+Yok" class="card-img-top" alt="Resim Yok">
                    }
                    <div class="card-body">
                        <h5 class="card-title">@item.Title</h5>
                        <div class="card-text" style="max-height: 60px; overflow: hidden;">@Html.Raw(item.Description)</div>
                        <h4 class="text-primary">@item.Price.ToString("C")</h4>
                        <p class="text-muted small">Ekleyen: @item.UserId</p>
                        @if (User.Identity.IsAuthenticated && (User.Identity.Name == item.UserId || User.IsInRole("Admin")))
                        {
                            <a asp-controller="Product" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning w-100 mt-2">İlanı Düzenle</a>
                            <form asp-controller="Product" asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bu ilanı kalıcı olarak silmek istediğinize emin misiniz?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100 mt-2">İlanı Sil</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>